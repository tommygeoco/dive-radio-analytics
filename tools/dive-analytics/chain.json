{
 "cron": "0 7 * * * America/Phoenix",
 "note": "Ordered chain definition (PRD v9 §4.5). The scheduler line above is documentation; the owner machine's OpenClaw automation `restream-postlive-snapshot` enters through run-daily.mjs, which runs this chain from an isolated main clone outside active development. validate.mjs block 1v reads `writes`, `freshnessKey`, `required`, and `scope` to decide which stores must be fresh before publish. `runtimeWrites` names operational state outside Git.",
 "steps": [
  {
   "step": "discover",
   "script": "scripts/restream/postlive-discover.mjs",
   "writes": [
    "data/restream/postlive-registry.json",
    "data/restream/source-receipts.json"
   ],
   "freshnessWrites": [
    "data/restream/source-receipts.json"
   ],
   "freshnessKey": "lastSuccessfulDiscoveryAt",
   "required": true,
   "scope": "all"
  },
  {
   "step": "transcripts",
   "script": "scripts/restream/transcripts-pull.mjs",
   "writes": [
    "transcripts/*.txt",
    "data/restream/transcript-state.json"
   ],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  },
  {
   "step": "newsletter-promotion",
   "script": "scripts/restream/beehiiv-promotions-pull.mjs",
   "writes": [
    "data/restream/beehiiv-promotions.json"
   ],
   "freshnessKey": "lastSuccessfulAt",
   "required": true,
   "scope": "all"
  },
  {
   "step": "snapshot",
   "script": "scripts/restream/postlive-track.mjs snapshot",
   "writes": [
    "data/restream/postlive/*.json",
    "data/restream/source-receipts.json"
   ],
   "freshnessKey": "snapshots[-1].ts",
   "required": true,
   "scope": "episodes-within-60d"
  },
  {
   "step": "yt-analytics",
   "script": "scripts/restream/yt-analytics-pull.mjs",
   "writes": [
    "data/restream/yt-analytics/*.json",
    "data/restream/yt-analytics-history/*.jsonl"
   ],
   "freshnessKey": "updatedAt",
   "required": true,
   "scope": "active-episodes"
  },
  {
   "step": "comments",
   "script": "scripts/restream/comments-pull.mjs",
   "writes": [
    "data/restream/comments/*.json"
   ],
   "freshnessKey": "updatedAt",
   "required": false,
   "scope": "active-episodes"
  },
  {
   "step": "classify",
   "script": "scripts/restream/comments-classify.mjs",
   "writes": [
    "data/restream/comments-classified.json"
   ],
   "freshnessKey": "updatedAt",
   "required": false,
   "scope": "all",
   "model": true
  },
  {
   "step": "channel-stats",
   "script": "scripts/restream/channel-stats-pull.mjs",
   "writes": [
    "data/restream/channel-stats.json"
   ],
   "freshnessKey": "updatedAt",
   "required": false,
   "scope": "all"
  },
  {
   "step": "live",
   "script": "scripts/restream/ingest-restream.mjs",
   "writes": [
    "data/restream/events/*.json",
    "data/restream/state.json"
   ],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  },
  {
   "step": "ratings",
   "script": "tools/dive-analytics/ratings.mjs",
   "writes": [
    "data/restream/episode-ratings.json"
   ],
   "freshnessKey": "updatedAt",
   "required": true,
   "scope": "all"
  },
  {
   "step": "build-data",
   "script": "tools/dive-analytics/build-data.mjs",
   "writes": [
    "data.json",
    "data.js",
    "agent.md",
    "agent.json",
    "llms.txt"
   ],
   "freshnessKey": "generatedAt",
   "required": true,
   "scope": "all"
  },
  {
   "step": "validate",
   "script": "tools/dive-analytics/audit/validate.mjs --publish",
   "writes": [],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  },
  {
   "step": "health",
   "script": "tools/dive-analytics/health.mjs",
   "writes": [
    "data/restream/health-history.json"
   ],
   "freshnessKey": "entries[-1].date",
   "required": false,
   "scope": "all",
   "model": true
  },
  {
   "step": "health-verify",
   "script": "tools/dive-analytics/health-verify.mjs",
   "writes": [
    "data/restream/health-verify.json",
    "tools/dive-analytics/audit/HEALTH-VERIFY.md"
   ],
   "freshnessKey": null,
   "required": false,
   "scope": "all"
  },
  {
   "step": "recommendations",
   "script": "tools/dive-analytics/recommendations.mjs",
   "writes": [
    "data/restream/recommendations.json"
   ],
   "freshnessKey": "updatedAt",
   "required": false,
   "scope": "all",
   "model": true
  },
  {
   "step": "moment-summaries",
   "script": "tools/dive-analytics/moment-summaries.mjs",
   "writes": [
    "data/restream/moment-summaries.json"
   ],
   "freshnessKey": null,
   "required": false,
   "scope": "all",
   "model": true
  },
  {
   "step": "chapters",
   "script": "tools/dive-analytics/chapters.mjs",
   "writes": [
    "data/restream/chapters.json"
   ],
   "freshnessKey": null,
   "required": false,
   "scope": "all",
   "model": true
  },
  {
   "step": "critic",
   "script": "tools/dive-analytics/critic.mjs",
   "writes": [
    "tools/dive-analytics/audit/CRITIC-*.md"
   ],
   "freshnessKey": null,
   "required": false,
   "scope": "all",
   "model": true,
   "when": "Mondays"
  },
  {
   "step": "build-data",
   "script": "tools/dive-analytics/build-data.mjs",
   "writes": [
    "data.json",
    "data.js",
    "agent.md",
    "agent.json",
    "llms.txt"
   ],
   "freshnessKey": "generatedAt",
   "required": true,
   "scope": "all"
  },
  {
   "step": "validate",
   "script": "tools/dive-analytics/audit/validate.mjs --publish",
   "writes": [],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  },
  {
   "step": "publish",
   "script": "scripts/restream/postlive-publish.sh",
   "writes": [],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  },
  {
   "step": "alerts",
   "script": "tools/dive-analytics/alerts.mjs",
   "writes": [],
   "runtimeWrites": [
    "~/Library/Application Support/Dive Radio Analytics/alerts-pending.json",
    "~/Library/Application Support/Dive Radio Analytics/alerts-state.json"
   ],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  },
  {
   "step": "freshness",
   "script": "tools/dive-analytics/freshness.mjs --strict",
   "writes": [],
   "runtimeWrites": [
    "~/Library/Application Support/Dive Radio Analytics/alerts-pending.json"
   ],
   "freshnessKey": null,
   "required": true,
   "scope": "all"
  }
 ]
}
